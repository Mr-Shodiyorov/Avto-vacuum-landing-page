# Public site URL used for metadataBase, canonical/hreflang tags, JSON-LD,
# the sitemap, and robots.txt. Set this to the real production domain in
# Vercel's environment variables. Falls back to http://localhost:<PORT> in
# development and to the hardcoded production domain (with a console
# warning) if left unset in production — see src/lib/site.ts.
NEXT_PUBLIC_SITE_URL=https://www.avtovakum.uz

# Supabase project credentials (before/after gallery cards, comments).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel — single shared password + JWT signing secret for the session
# cookie. See src/lib/session.ts / src/lib/session-token.ts.
SESSION_SECRET=
ADMIN_PASSWORD=
