---
import Logo from '@/components/Logo.astro';
import { site } from '@/lib/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <div class="site-footer__logo-row">
        <Logo size={36} innerBg="#08325F" textColor="#fff" ringA="#2C7BD1" />
        <span class="site-footer__name">AVTO VAKUM</span>
      </div>
      <p class="site-footer__desc">
        Avto vakuum, kuzov kassa prav, palirovka va keramika. Qarshi, 24/7.
      </p>
    </div>

    <div class="site-footer__col">
      <span class="site-footer__label">TELEFON</span>
      {site.phones.map((phone) => (
        <a class="site-footer__link" href={phone.href}>{phone.display}</a>
      ))}
    </div>

    <div class="site-footer__col">
      <span class="site-footer__label">IJTIMOIY TARMOQ</span>
      <a class="site-footer__link" href={site.instagram.url} target="_blank" rel="noopener noreferrer">
        Instagram · {site.instagram.handle}
      </a>
      <a class="site-footer__link" href={site.telegram.url} target="_blank" rel="noopener noreferrer">
        Telegram · {site.telegram.handle}
      </a>
      <span class="site-footer__hours">Har kuni 24 soat</span>
    </div>
  </div>

  <p class="site-footer__copy-mobile">Har kuni 24 soat · © {year} Avto Vakum, Qarshi</p>

  <div class="site-footer__bottom">
    <div class="container site-footer__bottom-inner">
      <span>© {year} Avto Vakum · Qarshi</span>
      <span>Barcha huquqlar himoyalangan</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-primary-deep);
    padding-block: 32px 96px;
  }
  .site-footer__grid {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .site-footer__brand {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .site-footer__logo-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .site-footer__name {
    font: 800 15px/1 var(--font-heading);
    color: #fff;
  }
  .site-footer__desc {
    font: 400 14px/1.65 var(--font-body);
    color: var(--color-on-primary-deep-muted);
    max-width: 34ch;
  }
  .site-footer__col {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .site-footer__label {
    font: 700 12px/1 var(--font-heading);
    color: var(--color-on-primary-deep-label);
    letter-spacing: 0.1em;
    margin-bottom: 2px;
  }
  .site-footer__link {
    align-self: flex-start;
    font: 500 14px/1.4 var(--font-body);
    color: #fff;
    text-decoration: none;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
  }
  .site-footer__link:hover {
    transform: translateX(3px);
  }
  .site-footer__col .site-footer__link:first-of-type {
    font: 700 16px/1 var(--font-heading);
  }
  .site-footer__link:hover {
    color: var(--color-accent);
  }
  .site-footer__hours {
    font: 400 13px/1.4 var(--font-body);
    color: var(--color-on-primary-deep-muted);
    margin-top: 6px;
  }
  .site-footer__copy-mobile {
    margin: 22px auto 0;
    max-width: var(--container-max);
    padding-inline: var(--gutter);
    font: 400 13px/1.5 var(--font-body);
    color: var(--color-on-primary-deep-faint);
  }
  .site-footer__bottom {
    display: none;
  }

  @media (min-width: 860px) {
    .site-footer {
      padding-block: 0;
    }
    .site-footer__grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr;
      gap: 48px;
      align-items: start;
      padding-block: 52px 40px;
    }
    .site-footer__name {
      font-size: 16px;
    }
    .site-footer__desc {
      font-size: 14px;
    }
    .site-footer__col .site-footer__link:first-of-type {
      font-size: 17px;
    }
    .site-footer__copy-mobile {
      display: none;
    }
    .site-footer__bottom {
      display: block;
      border-top: 1px solid rgba(255, 255, 255, 0.14);
    }
    .site-footer__bottom-inner {
      padding-block: 20px;
      display: flex;
      justify-content: space-between;
      gap: 20px;
      font: 400 13px/1 var(--font-body);
      color: var(--color-on-primary-deep-faint);
    }
  }
</style>
