---
import PhoneIcon from '@/components/icons/PhoneIcon.astro';
import InstagramIcon from '@/components/icons/InstagramIcon.astro';
import ImagePlaceholder from '@/components/ImagePlaceholder.astro';
import { site } from '@/lib/site';

const [phone1, phone2] = site.phones;
---

<section class="contact" id="aloqa">
  <div class="container">
    <div class="contact__card" data-reveal style="--reveal-scale:0.98">
      <span class="shine-border" aria-hidden="true">
        <span class="shine-border__spin"></span>
      </span>

      <div class="contact__text">
        <h2 class="contact__heading">Qo'ng'iroq qiling — hoziroq qabul qilamiz</h2>
        <p class="contact__lead">
          Ikkala raqam ham 24 soat ishlaydi. Xizmat narxi va bo'sh joyni telefon orqali ayting.
        </p>

        <div class="contact__phones">
          <a class="contact__phone contact__phone--accent shimmer-cta" href={phone1.href}>
            <span>{phone1.display}</span>
            <PhoneIcon size={20} />
          </a>
          <a class="contact__phone contact__phone--primary" href={phone2.href}>
            <span>{phone2.display}</span>
            <PhoneIcon size={20} />
          </a>
          <a
            class="contact__insta"
            href={site.instagram.url}
            target="_blank"
            rel="noopener noreferrer"
          >
            <InstagramIcon size={19} />
            Instagram — {site.instagram.handle}
          </a>
        </div>
      </div>

      <div class="contact__media">
        <ImagePlaceholder
          label="Servis fotosi yoki xarita skrinshoti"
          ratio="16 / 9"
          radius="14px"
          class="contact__map"
        />

        <div class="contact__info">
          <div class="contact__info-item">
            <span class="contact__info-label">MANZIL</span>
            <span class="contact__info-value">{site.address}</span>
          </div>
          <div class="contact__info-divider" aria-hidden="true"></div>
          <div class="contact__info-item">
            <span class="contact__info-label">ISH VAQTI</span>
            <span class="contact__info-value">{site.hours}</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: 40px 48px;
  }
  .contact__card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* --- Shine border ------------------------------------------------------
     A large gradient square rotates behind the card and is clipped to a 1px
     ring by an inner cover matching the card surface. The gradient is painted
     once and only transformed, so the loop stays on the compositor. The card
     is only a bordered box from 860px up, so the effect is desktop-only. */
  .shine-border {
    display: none;
  }

  @keyframes shineSpin {
    to {
      transform: translate(-50%, -50%) rotate(360deg);
    }
  }

  @media (min-width: 860px) {
    .shine-border {
      display: block;
      position: absolute;
      /* -1px lines the ring up with the card's own border box. */
      inset: -1px;
      z-index: 0;
      border-radius: calc(var(--radius-xl) + 1px);
      overflow: hidden;
      pointer-events: none;
    }
    .shine-border__spin {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 150%;
      aspect-ratio: 1 / 1;
      transform: translate(-50%, -50%);
      /* Base tone matches the static border, so only the highlight travels. */
      background: conic-gradient(
        from 0deg,
        var(--color-border) 0deg 250deg,
        rgba(11, 74, 143, 0.45) 288deg,
        rgba(245, 135, 31, 0.95) 310deg,
        rgba(255, 255, 255, 0.95) 320deg,
        rgba(245, 135, 31, 0.5) 332deg,
        var(--color-border) 360deg
      );
      animation: shineSpin 9s linear infinite;
    }
    /* Covers everything but a 1px rim, leaving just the travelling highlight. */
    .shine-border::after {
      content: '';
      position: absolute;
      inset: 1px;
      border-radius: var(--radius-xl);
      background: var(--color-surface);
    }
    /* Content sits above the ring. */
    .contact__text,
    .contact__media {
      position: relative;
      z-index: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shine-border__spin {
      animation: none;
    }
  }
  .contact__heading {
    font: 800 28px/1.14 var(--font-heading);
    letter-spacing: -0.02em;
    color: var(--color-text);
    text-wrap: pretty;
    margin-bottom: 12px;
  }
  .contact__lead {
    font: 400 15px/1.6 var(--font-body);
    color: var(--color-text-soft);
    margin-bottom: 18px;
  }
  .contact__phones {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 420px;
  }
  .contact__phone {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: #fff;
    font: 800 20px/1 var(--font-heading);
    padding: 20px 22px;
    border-radius: 12px;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      background-color 0.2s ease;
  }
  .contact__phone--accent {
    background: var(--color-accent);
    box-shadow: 0 2px 0 var(--color-accent-shadow);
  }
  .contact__phone--accent:hover {
    background: var(--color-accent-hover);
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 10px 22px rgba(197, 105, 12, 0.32);
  }
  .contact__phone--primary {
    background: var(--color-primary);
    box-shadow: 0 2px 0 var(--color-primary-deeper);
  }
  .contact__phone--primary:hover {
    background: var(--color-primary-hover);
    transform: translateY(-2px) scale(1.02);
    box-shadow: 0 10px 22px rgba(11, 74, 143, 0.28);
  }
  .contact__insta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: var(--color-surface);
    border: 1px solid #c9d3e0;
    color: var(--color-primary);
    font: 700 16px/1 var(--font-heading);
    padding: 19px;
    border-radius: 12px;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease;
  }
  .contact__insta:hover {
    border-color: var(--color-primary);
    background: var(--color-badge-bg);
    transform: translateY(-2px);
  }
  .contact__media {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .contact__map {
    display: none;
  }
  .contact__info {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .contact__info-divider {
    height: 1px;
    background: var(--color-border);
  }
  .contact__info-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .contact__info-label {
    font: 600 11px/1 var(--font-body);
    color: var(--color-text-faint);
    letter-spacing: 0.08em;
  }
  .contact__info-value {
    font: 500 15px/1.5 var(--font-body);
    color: var(--color-text);
  }

  @media (min-width: 860px) {
    .contact {
      padding-block: 88px 96px;
    }
    .contact__card {
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-xl);
      padding: 56px;
      display: grid;
      grid-template-columns: 1.1fr 1fr;
      gap: 56px;
      align-items: center;
    }
    .contact__heading {
      font-size: 40px;
      line-height: 1.14;
      margin-bottom: 0;
    }
    .contact__lead {
      font-size: 17px;
      max-width: 42ch;
      margin-bottom: 0;
    }
    .contact__text {
      display: flex;
      flex-direction: column;
      gap: 22px;
    }
    .contact__map {
      display: block;
    }
    .contact__info {
      background: none;
      border: none;
      padding: 0;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
    }
    .contact__info-divider {
      display: none;
    }
    .contact__info-item {
      background: var(--color-bg);
      border-radius: var(--radius-md);
      padding: 20px;
    }
  }
</style>
