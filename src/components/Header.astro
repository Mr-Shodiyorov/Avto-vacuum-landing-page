---
import Logo from '@/components/Logo.astro';
import InstagramIcon from '@/components/icons/InstagramIcon.astro';
import TelegramIcon from '@/components/icons/TelegramIcon.astro';
import { site, navLinks } from '@/lib/site';

const primaryPhone = site.phones[0];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="#top" class="site-header__brand" aria-label={`${site.name} — bosh sahifa`}>
      <Logo size={46} />
      <span class="site-header__brand-text">
        <span class="site-header__name">AVTO VAKUM</span>
        <span class="site-header__tag">TOSHKENT · 24/7</span>
      </span>
    </a>

    <nav class="site-header__nav" aria-label="Asosiy navigatsiya">
      {navLinks.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>

    <div class="site-header__actions">
      <a class="site-header__phone" href={primaryPhone.href}>{primaryPhone.display}</a>
      <a
        class="site-header__contact-btn"
        href={site.telegram.url}
        target="_blank"
        rel="noopener noreferrer"
      >
        <TelegramIcon size={17} />
        Bog'lanish
      </a>
      <a class="site-header__cta" href={primaryPhone.href}>Qo'ng'iroq qilish</a>
    </div>

    <div class="site-header__mobile-actions">
      <a
        class="site-header__icon-btn site-header__icon-btn--telegram"
        href={site.telegram.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Bog'lanish — Telegram"
      >
        <TelegramIcon size={19} color="#fff" />
      </a>
      <a
        class="site-header__icon-btn"
        href={site.instagram.url}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Instagram — ${site.instagram.handle}`}
      >
        <InstagramIcon size={20} color="#0B4A8F" />
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 40;
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 72px;
  }
  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: inherit;
  }
  .site-header__brand-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .site-header__name {
    font: 800 15px/1 var(--font-heading);
    letter-spacing: -0.01em;
    color: var(--color-text);
  }
  .site-header__tag {
    font: 500 10px/1 var(--font-body);
    color: var(--color-text-faint);
    letter-spacing: 0.09em;
  }
  .site-header__nav,
  .site-header__actions {
    display: none;
  }
  .site-header__mobile-actions {
    margin-left: auto;
    display: flex;
    gap: 10px;
  }
  .site-header__icon-btn {
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .site-header__icon-btn:hover {
    border-color: var(--color-primary);
  }
  .site-header__icon-btn--telegram {
    background: var(--color-telegram);
    border-color: var(--color-telegram);
  }
  .site-header__icon-btn--telegram:hover {
    background: var(--color-telegram-hover);
    border-color: var(--color-telegram-hover);
  }

  @media (min-width: 860px) {
    .site-header__inner {
      height: 84px;
      gap: 40px;
    }
    .site-header__brand {
      gap: 14px;
    }
    .site-header__name {
      font-size: 17px;
    }
    .site-header__nav {
      display: flex;
      gap: 30px;
      margin-left: 20px;
    }
    .site-header__nav a {
      font: 500 15px/1 var(--font-body);
      color: #3d4a5c;
      text-decoration: none;
      transition: color 0.15s ease;
    }
    .site-header__nav a:hover {
      color: var(--color-primary);
    }
    .site-header__actions {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-left: auto;
    }
    .site-header__phone {
      font: 700 17px/1 var(--font-heading);
      color: var(--color-primary);
      text-decoration: none;
      white-space: nowrap;
      margin-right: 4px;
    }
    .site-header__contact-btn {
      display: flex;
      align-items: center;
      gap: 9px;
      background: var(--color-telegram);
      color: #fff;
      font: 700 15px/1 var(--font-heading);
      padding: 13px 18px;
      border-radius: 8px;
      text-decoration: none;
      white-space: nowrap;
      transition: background-color 0.15s ease;
    }
    .site-header__contact-btn:hover {
      background: var(--color-telegram-hover);
    }
    .site-header__cta {
      background: var(--color-accent);
      color: #fff;
      font: 700 15px/1 var(--font-heading);
      padding: 14px 22px;
      border-radius: 8px;
      text-decoration: none;
      white-space: nowrap;
      transition: background-color 0.15s ease;
    }
    .site-header__cta:hover {
      background: var(--color-accent-hover);
    }
    .site-header__mobile-actions {
      display: none;
    }
  }
</style>
