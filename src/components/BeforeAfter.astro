---
import ImagePlaceholder from '@/components/ImagePlaceholder.astro';

interface WorkItem {
  title: string;
  meta: string;
  before: string;
  after: string;
}

const items: WorkItem[] = [
  {
    title: 'Salon vakuumi',
    meta: 'Cobalt · 45 daq',
    before: "OLDIN — iflos salon",
    after: "KEYIN — toza salon",
  },
  {
    title: 'Kuzov kassa prav',
    meta: 'Malibu · 2 soat',
    before: 'OLDIN — vmyatina',
    after: 'KEYIN — tekis kuzov',
  },
  {
    title: 'Palirovka + keramika',
    meta: 'Tracker · 1 kun',
    before: "OLDIN — xira bo'yoq",
    after: 'KEYIN — jilolangan',
  },
];
---

<section class="works" id="ishlarimiz">
  <div class="container">
    <div class="works__heading-group" data-reveal>
      <span class="eyebrow">ISHLARIMIZ</span>
      <h2 class="section-heading">Oldin va keyin</h2>
    </div>

    <div class="works__grid">
      {items.map((item, i) => (
        <article class="work-card" data-reveal style={`--reveal-delay:${i * 120}ms`}>
          <div class="work-card__images">
            <ImagePlaceholder label={item.before} tag="OLDIN" ratio="1 / 1" />
            <ImagePlaceholder label={item.after} tag="KEYIN" ratio="1 / 1" />
          </div>
          <div class="work-card__footer">
            <span class="work-card__title">{item.title}</span>
            <span class="work-card__meta">{item.meta}</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .works {
    padding-block: 40px 8px;
  }
  .works__heading-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 20px;
  }
  .works__grid {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .work-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }
  .work-card:hover {
    transform: translateY(-4px);
    border-color: #cfd8e4;
    box-shadow: 0 14px 30px rgba(16, 26, 40, 0.1);
  }
  /* Hint the transformation: the "before" tag recedes, the "after" tag steps up. */
  .work-card :global(.img-placeholder__tag) {
    transition:
      transform 0.25s ease,
      opacity 0.25s ease;
  }
  .work-card:hover .work-card__images > :global(*:first-child .img-placeholder__tag) {
    opacity: 0.5;
    transform: scale(0.96);
  }
  .work-card:hover .work-card__images > :global(*:last-child .img-placeholder__tag) {
    transform: scale(1.08);
  }
  .work-card__images {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
    background: var(--color-border);
  }
  .work-card__footer {
    padding: 14px 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }
  .work-card__title {
    font: 700 15px/1.3 var(--font-heading);
    color: var(--color-text);
  }
  .work-card__meta {
    font: 400 13px/1.3 var(--font-body);
    color: var(--color-text-faint);
  }

  @media (min-width: 860px) {
    .works {
      padding-block: 88px 20px;
    }
    .works__heading-group {
      margin-bottom: 36px;
    }
    .works__grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
    .work-card__images > :global(*) {
      height: 230px;
    }
    .work-card__footer {
      padding: 18px 20px;
    }
    .work-card__title {
      font-size: 16px;
    }
    .work-card__meta {
      font-size: 14px;
    }
  }
</style>
