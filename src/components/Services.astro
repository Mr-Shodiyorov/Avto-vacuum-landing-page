---
interface Service {
  title: string;
  description: string;
  meta: string;
  icon: string;
}

const services: Service[] = [
  {
    title: 'Avto vakuum',
    description:
      "Salonni to'liq tozalash: gilamlar, o'rindiqlar, bagaj va yetib bo'lmaydigan burchaklar.",
    meta: '30–50 daqiqa',
    icon: '<rect x="3" y="12" width="14" height="11" rx="3" fill="#0B4A8F"></rect><circle cx="19" cy="7" r="4" stroke="#0B4A8F" stroke-width="2"></circle><path d="M10 12V9h5" stroke="#0B4A8F" stroke-width="2"></path>',
  },
  {
    title: 'Kuzov kassa prav',
    description: "Bo'yoqsiz vmyatina to'g'rilash va kuzov geometriyasini tiklash.",
    meta: "Bo'yoqsiz usul",
    icon: '<rect x="3" y="8" width="20" height="10" rx="3" stroke="#0B4A8F" stroke-width="2"></rect><circle cx="13" cy="13" r="3" fill="#F5871F"></circle>',
  },
  {
    title: 'Palirovka',
    description: "Tashqi sathni jilolash — mayda chiziqlar va xiralikni yo'qotamiz.",
    meta: '1–3 bosqich',
    icon: '<circle cx="11" cy="14" r="7" stroke="#0B4A8F" stroke-width="2"></circle><path d="M19 3.5l1.4 3.1L23.5 8l-3.1 1.4L19 12.5l-1.4-3.1L14.5 8l3.1-1.4L19 3.5Z" fill="#F5871F"></path>',
  },
  {
    title: 'Keramika',
    description: 'Keramik qoplama: uzoq muddatli himoya, chuqur yorqinlik va oson yuvish.',
    meta: '1 yilgacha himoya',
    icon: '<path d="M13 2.5 22 6v7c0 5-4 8.6-9 10.5C8 21.6 4 18 4 13V6l9-3.5Z" stroke="#0B4A8F" stroke-width="2" stroke-linejoin="round"></path><circle cx="13" cy="12" r="3" fill="#F5871F"></circle>',
  },
];
---

<section class="services" id="xizmatlar">
  <div class="container">
    <div class="services__head">
      <div class="services__heading-group">
        <span class="eyebrow">XIZMATLAR</span>
        <h2 class="section-heading">To'rtta asosiy xizmat</h2>
      </div>
      <p class="services__note">
        Narxni telefon orqali aniqlashtiramiz — avtomobil rusumi va holatiga qarab.
      </p>
    </div>

    <div class="services__grid">
      {services.map((service) => (
        <article class="service-card">
          <div class="service-card__icon" set:html={`<svg width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true">${service.icon}</svg>`} />
          <div class="service-card__body">
            <h3 class="service-card__title">{service.title}</h3>
            <p class="service-card__desc">{service.description}</p>
            <span class="service-card__meta">{service.meta}</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style is:global>
  .eyebrow {
    font: 700 12px/1 var(--font-heading);
    color: var(--color-accent);
    letter-spacing: 0.12em;
  }
  .section-heading {
    font: 800 28px/1.15 var(--font-heading);
    letter-spacing: -0.02em;
    color: var(--color-text);
  }
  @media (min-width: 860px) {
    .eyebrow {
      font-size: 13px;
    }
    .section-heading {
      font-size: 40px;
    }
  }
</style>

<style>
  .services {
    padding-block: 40px 8px;
  }
  .services__head {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 20px;
  }
  .services__heading-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .services__heading-group h2 {
    margin: 0 0 6px;
  }
  .services__note {
    font: 400 15px/1.6 var(--font-body);
    color: var(--color-text-faint);
  }
  .services__grid {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .service-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 20px;
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }
  .service-card__icon {
    width: 46px;
    height: 46px;
    border-radius: 11px;
    background: var(--color-badge-bg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }
  .service-card__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .service-card__title {
    font: 800 18px/1.25 var(--font-heading);
    color: var(--color-text);
    text-wrap: pretty;
  }
  .service-card__desc {
    font: 400 14px/1.55 var(--font-body);
    color: var(--color-text-soft);
    text-wrap: pretty;
  }
  .service-card__meta {
    font: 600 13px/1 var(--font-body);
    color: var(--color-primary);
  }

  @media (min-width: 860px) {
    .services {
      padding-block: 92px 20px;
    }
    .services__head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: 40px;
      margin-bottom: 38px;
    }
    .services__note {
      font-size: 16px;
      max-width: 38ch;
      text-align: right;
    }
    .services__grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
    .service-card {
      flex-direction: column;
      gap: 18px;
      padding: 30px 26px 32px;
      transition: border-color 0.15s ease, box-shadow 0.15s ease;
    }
    .service-card:hover {
      border-color: var(--color-primary);
      box-shadow: 0 10px 28px rgba(16, 26, 40, 0.08);
    }
    .service-card__icon {
      width: 52px;
      height: 52px;
      border-radius: 12px;
    }
    .service-card__body {
      display: contents;
    }
    .service-card__title {
      font-size: 21px;
    }
    .service-card__desc {
      font-size: 15px;
      line-height: 1.6;
    }
    .service-card__meta {
      font-size: 14px;
      margin-top: auto;
    }
  }

  @media (min-width: 1160px) {
    .services__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
