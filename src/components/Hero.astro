---
import { Image } from 'astro:assets';
import PhoneIcon from '@/components/icons/PhoneIcon.astro';
import InstagramIcon from '@/components/icons/InstagramIcon.astro';
import { site, master } from '@/lib/site';
import ustaPhoto from '@/assets/usta-hero.png';

const primaryPhone = site.phones[0];

const stats = [
  { value: '5 000+', label: "tozalangan avtomobil" },
  { value: '7 yil', label: 'tajribali ustalar' },
  { value: '40 daq', label: "o'rtacha vakuum vaqti" },
];
---

<section class="hero" id="top">
  <div class="container hero__grid">
    <p class="hero__badge">
      <span class="hero__badge-dot" aria-hidden="true"></span>
      24/7 OCHIQ · HOZIR ISHLAYMIZ
    </p>

    <h1 class="hero__heading">Avtomobilingiz toza — kunning istalgan vaqtida</h1>

    <p class="hero__lead">
      Avto vakuum, kuzov kassa prav, palirovka va keramika. Toshkent markazida, kechayu kunduz.
      Navbatsiz qabul qilamiz — qo'ng'iroq qiling va keling.
    </p>

    <div class="hero__media">
      <div class="hero__portrait">
        <Image
          src={ustaPhoto}
          alt={`${master.title} — Avto Vakum`}
          width={546}
          height={457}
          format="webp"
          quality={90}
          loading="eager"
          fetchpriority="high"
          class="hero__portrait-img"
        />
      </div>
      <div class="hero__floating-badge">
        <span class="hero__floating-badge-icon">{master.experienceYears}</span>
        <span class="hero__floating-badge-text">
          <span class="hero__floating-badge-title">{master.experienceLabel}</span>
          <span class="hero__floating-badge-sub">{master.title} xizmatlari</span>
        </span>
      </div>
    </div>

    <div class="hero__cta">
      <a class="hero__cta-call" href={primaryPhone.href}>
        <PhoneIcon size={20} />
        {primaryPhone.display}
      </a>
      <a
        class="hero__cta-insta"
        href={site.instagram.url}
        target="_blank"
        rel="noopener noreferrer"
      >
        <InstagramIcon size={18} />
        {site.instagram.handle}
      </a>
    </div>

    <div class="hero__stats">
      {stats.map((stat) => (
        <div class="hero__stat">
          <span class="hero__stat-value">{stat.value}</span>
          <span class="hero__stat-label">{stat.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }
  .hero__grid {
    display: grid;
    grid-template-areas:
      'badge'
      'heading'
      'lead'
      'media'
      'cta'
      'stats';
    gap: 20px;
    padding-block: 32px 40px;
  }
  .hero__badge {
    grid-area: badge;
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 9px;
    margin: 0;
    background: var(--color-badge-bg);
    border: 1px solid var(--color-badge-border);
    border-radius: 999px;
    padding: 8px 14px 8px 11px;
    font: 700 12px/1 var(--font-heading);
    color: var(--color-primary);
    letter-spacing: 0.04em;
  }
  .hero__badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-success);
    flex: none;
  }
  .hero__heading {
    grid-area: heading;
    font: 800 34px/1.12 var(--font-heading);
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }
  .hero__lead {
    grid-area: lead;
    font: 400 16px/1.6 var(--font-body);
    color: var(--color-text-muted);
    text-wrap: pretty;
  }
  .hero__media {
    grid-area: media;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .hero__portrait {
    position: relative;
    min-height: 280px;
    border-radius: 24px;
    background: radial-gradient(65% 65% at 50% 88%, var(--color-badge-bg) 0%, transparent 70%);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    overflow: visible;
  }
  .hero__portrait :global(.hero__portrait-img) {
    width: auto;
    max-width: 88%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 18px 26px rgba(16, 26, 40, 0.18));
  }
  .hero__floating-badge {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 14px 16px;
    box-shadow: 0 6px 16px rgba(16, 26, 40, 0.06);
  }
  .hero__floating-badge-icon {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font: 800 13px/1 var(--font-heading);
    color: #fff;
    flex: none;
  }
  .hero__floating-badge-text {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .hero__floating-badge-title {
    font: 700 14px/1.2 var(--font-heading);
    color: var(--color-text);
  }
  .hero__floating-badge-sub {
    font: 400 12px/1.2 var(--font-body);
    color: var(--color-text-faint);
  }
  .hero__cta {
    grid-area: cta;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .hero__cta-call,
  .hero__cta-insta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    text-decoration: none;
    font-family: var(--font-heading);
    border-radius: 12px;
  }
  .hero__cta-call {
    background: var(--color-accent);
    color: #fff;
    font-weight: 800;
    font-size: 19px;
    padding: 20px;
    box-shadow: 0 2px 0 var(--color-accent-shadow);
    transition: background-color 0.15s ease;
  }
  .hero__cta-call:hover {
    background: var(--color-accent-hover);
  }
  .hero__cta-insta {
    display: none;
    background: var(--color-surface);
    border: 1px solid #c9d3e0;
    color: var(--color-primary);
    font-weight: 700;
    font-size: 16px;
    padding: 18px;
    transition: border-color 0.15s ease;
  }
  .hero__cta-insta:hover {
    border-color: var(--color-primary);
  }
  .hero__stats {
    grid-area: stats;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    text-align: center;
  }
  .hero__stat {
    background: var(--color-bg);
    border-radius: 10px;
    padding: 14px 8px;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .hero__stat-value {
    font: 800 18px/1 var(--font-heading);
    color: var(--color-primary);
  }
  .hero__stat-label {
    font: 400 12px/1.3 var(--font-body);
    color: var(--color-text-faint);
  }

  @media (min-width: 860px) {
    .hero__grid {
      grid-template-columns: 1.02fr 1fr;
      grid-template-areas:
        'badge   media'
        'heading media'
        'lead    media'
        'cta     media'
        'stats   media';
      column-gap: 64px;
      row-gap: 26px;
      align-items: center;
      padding-block: 64px 72px;
    }
    .hero__badge {
      padding: 9px 16px 9px 12px;
      font-size: 13px;
    }
    .hero__badge-dot {
      width: 9px;
      height: 9px;
    }
    .hero__heading {
      font-size: 58px;
      line-height: 1.08;
      max-width: 16ch;
    }
    .hero__lead {
      font-size: 19px;
      line-height: 1.62;
      max-width: 46ch;
    }
    .hero__media {
      display: block;
    }
    .hero__portrait {
      height: 470px;
      min-height: 0;
    }
    .hero__floating-badge {
      position: absolute;
      left: -26px;
      bottom: -26px;
      gap: 14px;
      padding: 18px 22px;
      box-shadow: 0 8px 24px rgba(16, 26, 40, 0.1);
    }
    .hero__floating-badge-icon {
      width: 44px;
      height: 44px;
      font-size: 15px;
    }
    .hero__floating-badge-title {
      font-size: 15px;
    }
    .hero__floating-badge-sub {
      font-size: 13px;
    }
    .hero__cta {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
    }
    .hero__cta-call {
      font-size: 19px;
      padding: 20px 30px;
      box-shadow: 0 2px 0 var(--color-accent-shadow);
    }
    .hero__cta-insta {
      display: flex;
      font-size: 17px;
      padding: 19px 26px;
    }
    .hero__stats {
      display: flex;
      gap: 28px;
      text-align: left;
      padding-top: 8px;
    }
    .hero__stat {
      background: none;
      padding: 0;
      gap: 4px;
      position: relative;
    }
    .hero__stat:not(:first-child) {
      padding-left: 28px;
    }
    .hero__stat:not(:first-child)::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 1px;
      background: var(--color-border);
    }
    .hero__stat-value {
      font-size: 24px;
    }
    .hero__stat-label {
      font-size: 14px;
    }
  }
</style>
