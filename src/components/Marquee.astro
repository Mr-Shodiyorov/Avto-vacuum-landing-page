---
// Decorative keyword strip. The track holds two identical groups and shifts by
// -50%, so the loop is seamless. Marked aria-hidden — every term here is already
// announced in the Services section.
const keywords = [
  'Avto vakuum',
  'Keramika',
  'Palirovka',
  'Kuzov kassa prav',
  'Salon tozalash',
  '24/7 xizmat',
];
---

<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {[0, 1].map(() => (
      <div class="marquee__group">
        {keywords.map((word) => (
          <span class="marquee__item">
            {word}
            <span class="marquee__sep">·</span>
          </span>
        ))}
      </div>
    ))}
  </div>
</div>

<style>
  @keyframes marqueeScroll {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .marquee {
    /* overflow:hidden keeps the oversized track from ever widening the page */
    overflow: hidden;
    background: var(--color-primary);
    border-block: 1px solid rgba(255, 255, 255, 0.12);
    padding-block: 13px;
    user-select: none;
  }
  .marquee__track {
    display: flex;
    width: max-content;
    animation: marqueeScroll 34s linear infinite;
  }
  .marquee:hover .marquee__track {
    animation-play-state: paused;
  }
  .marquee__group {
    display: flex;
    flex: none;
  }
  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 22px;
    padding-right: 22px;
    white-space: nowrap;
    font: 700 13px/1 var(--font-heading);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
  }
  .marquee__sep {
    color: var(--color-accent);
  }

  @media (min-width: 860px) {
    .marquee {
      padding-block: 16px;
    }
    .marquee__item {
      font-size: 14px;
      gap: 28px;
      padding-right: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
  }
</style>
